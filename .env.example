# Copy this file to .env and fill in real values. Do not commit .env.

# Flask session signing key. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Postgres connection string. If unset, falls back to a local SQLite file
# (fine for local dev, not for production).
DATABASE_URL=postgresql://user:password@localhost:5432/stonk_advisor

# Market data provider. Get a free key at https://finnhub.io
FINNHUB_API_KEY=

# Comma-separated list of origins allowed to make credentialed API requests.
CORS_ORIGINS=http://localhost:3001

# Set to "true" once served over HTTPS in production.
SESSION_COOKIE_SECURE=false
